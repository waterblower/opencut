#!/bin/bash
set -eu

# Cargo still uses the system pkg-config executable for unrelated dependencies.
for argument in "$@"; do
    case "$argument" in
        gstreamer-*|gst-editing-services-*|glib-*|gobject-*|gio-*|gmodule-*|gthread-*|faac)
            script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
            framework="$script_dir/../vendor/gstreamer/GStreamer.framework/Versions/1.0"
            if [[ ! -f "$framework/lib/pkgconfig/gstreamer-1.0.pc" ]]; then
                echo "$0:$LINENO: Vendored GStreamer is missing. Run: python3 $script_dir/setup_gstreamer.py" >&2
                exit 1
            fi
            # Disable all system metadata search paths for the GStreamer stack.
            export PKG_CONFIG_PATH="$framework/lib/pkgconfig:$framework/share/pkgconfig"
            export PKG_CONFIG_LIBDIR="$PKG_CONFIG_PATH"
            unset PKG_CONFIG_SYSROOT_DIR
            break
            ;;
    esac
done

exec pkg-config "$@"
